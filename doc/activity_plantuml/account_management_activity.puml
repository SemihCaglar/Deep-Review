@startuml
title Account Management Activity Diagram
skinparam shadowing false
skinparam ActivityDiamondFontSize 12
skinparam ConditionEndStyle diamond

|Coordinator|
|User|
start

:User Accesses Home;

if (Has Account?) then (No)
  :Sign Up;
  |Coordinator|
  :Review Sign-Up Request;
  if (Approve?) then (Yes)
    |User|
  else (No)
    :Reject Sign-Up Request;
    stop
  endif
else (Yes)
  if (Forgot Password?) then (Yes)
    :Request Password Reset;
    |System|
    :Send Password Reset Email;
    |User|
    :Click Link & Reset Password;
  else (No)
    :Log In;
  endif
endif

|User|
:User Authenticated;

while (Keep Session Active?) is (Yes)
  switch (Choose Action)
  case (Update Profile)
    :Update Basic Profile;
  case (Set Interests)
    :Set Interests (Topics);
  case (Set Schedule)
    :Set Availability Schedule;
  case (Change Pwd)
    :Change Password;
  endswitch
endwhile (No, Log Out)

:Log Out;
stop

@enduml
