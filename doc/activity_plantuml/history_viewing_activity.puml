@startuml
title History Viewing Activity Diagram
skinparam shadowing false
skinparam linetype ortho

start

switch (Role?)
case (Author)
  :View My Written Papers;
  fork
    :View Paper Status;
  fork again
    :View Full Paper History;
    note right: Includes all rounds,\n decisions, and artifacts.
  end fork

case (Coordinator)
  :View All Papers;
  fork
    :View Paper Status;
  fork again
    :View Full Paper History;
    note right: Includes all rounds,\n decisions, and artifacts.
  end fork

case (Reviewer)
  :View Currently Assigned Papers;
  :View Paper Status;
endswitch

stop
@enduml
