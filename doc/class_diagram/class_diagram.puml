@startuml

package "Controllers" {
    class AccountController <<Controller>> {
        +signUp(userData: any): void
        +login(credentials: any): void
        +logout(userId: string): void
        +changePassword(userId: string, oldPw: string, newPw: string): void
        +sendPasswordReset(email: string): void
        +resetPassword(userId: string, newPw: string): void
        +updateProfile(userId: string, profileData: any): void
        +setInterests(userId: string, topicIds: string[]): void
        +setBlackoutPeriods(userId: string, periods: any[]): void
        +approveSignUp(coordinatorId: string, userId: string): void
        +rejectSignUp(coordinatorId: string, userId: string, reason: string): void
    }
    class AssignmentController <<Controller>> {
        +assignReviewers(roundId: string, coordinatorId: string, reviewerIds: string[], paperId: string): void
        +sendInvitations(assignmentIds: string[]): void
        +sendReminders(assignmentIds: string[]): void
        +cancelAssignment(assignmentId: string, coordinatorId: string): void
        +updateAssignmentDeadline(assignmentId: string, coordinatorId: string, newDeadline: Date): void
    }
    class AdminController <<Controller>> {
        +createUser(userData: any): string
        +updateUserRole(userId: string, newRoles: string[]): void
        +lockUserAccount(userId: string, reason: string): void
        +unlockUserAccount(userId: string): void
        +deleteUser(userId: string): void

        +createTopic(topicName: string): string
        +updateTopic(topicId: string, newName: string): void
        +deleteTopic(topicId: string): void

        +getSystemLogs(filters?: any): any[]
    }
    class EmailController <<Controller>> {
        +sendNotification(userId: string, subject: string, body: string): void
        +sendPasswordResetEmail(email: string, resetLink: string): void
        +retryFailedEmails(): void
    }
    class AIReviewController <<Controller>> {
        +runAIReview(roundId: string, requesterId: string): string
        +generateReviewReport(roundId: string): any
        +generateAnnotatedPDF(roundId: string): any
        +performPCRelatedWorkScan(roundId: string): any[]
        +getChecklist(roundId: string): any
        +validateAIOutput(aiReviewId: string): boolean
    }
    class PaperController <<Controller>> {
        +registerPaper(authorIds: string[], title: string, abstract: string, targetVenue: string): string
        +setTopics(paperId: string, topicIds: string[]): void
        +uploadManuscript(paperId: string, overleafLink: string): void
        +linkParentPapers(paperId: string, parentPaperIds: string[]): void
        +updateAbstract(paperId: string, newAbstract: string): void
        +updateTopics(paperId: string, newTopicIds: string[]): void
        +getPaperStatus(userId: string, paperId: string): any
        +getPaperHistory(userId: string, paperId: string): any
        +getMyWrittenPapers(authorId: string): any[]
        +getMyReviewedPapers(reviewerId: string): any[]
        +getMyCurrentReviewedPapers(reviewerId: string): any[]
        +getAllPapers(coordinatorId: string): any[]
        +updatePaperStatus(paperId: string, status: PaperStatus): void
    }
    class RatingAnalyticsController <<Controller>> {
        +rateReviewer(assignmentId: string, authorId: string, quality: number, quantity: number, time: number): void
        +getOverallAnalytics(coordinatorId: string): any
        +getUserAnalytics(userId: string): any
    }
    class ReviewerResponseController <<Controller>> {
        +respondToInvitation(assignmentId: string, reviewerId: string, isAccept: boolean, reason?: string): void
        +requestDecline(assignmentId: string, reviewerId: string, reason: string): void
        +requestDeadlineExtension(assignmentId: string, reviewerId: string, reason: string): void
        +processDeclineRequest(assignmentId: string, coordinatorId: string, isApproved: boolean): void
        +processExtensionRequest(assignmentId: string, coordinatorId: string, isApproved: boolean, newDeadline?: Date): void
        +submitReviewSummary(assignmentId: string, reviewerId: string, summaryText: string): void
        +markReviewCompleted(assignmentId: string, reviewerId: string): void
    }
    class RoundController <<Controller>> {
        +createReviewRound(paperId: string, coordinatorId: string): string
        +editRoundDeadline(roundId: string, coordinatorId: string, newDeadline: Date): void
        +suggestReviewers(roundId: string, coordinatorId: string): any[]
        +addProposeReviewer(roundId: string, coordinatorId: string, reviewerId: string): void
        +getProposeReviewers(roundId: string, coordinatorId: string): any[]
        +trackReviewStatus(roundId: string): any
        +alertOverdueReviews(roundId: string): void
        +closeRound(roundId: string, coordinatorId: string): void
        +startNextRound(paperId: string, coordinatorId: string): string
        +startAIReview(roundId: string, requesterId: string): void
        +addChecklistItem(roundId: string, description: string): string
        +removeChecklistItem(roundId: string, itemId: string): void
        +updateChecklistItem(roundId: string, itemId: string, isChecked: boolean): void
    }
    class SearchController <<Controller>> {
        +searchPapersByTitle(title: string): Paper[]
        +searchPapersByStatus(status: string): Paper[]
        +searchPapersByVenue(targetVenue: string): Paper[]
        +searchPapersByAuthor(authorId: string): Paper[]
        +searchPapersByTopic(topicId: string): Paper[]
        +searchPapersByDateRange(createdAfter: Date, createdBefore: Date): Paper[]
        +searchPapersByClosed(): Paper[]
        +searchPapersByArchived(): Paper[]
        +searchReviewsByPaper(paperId: string): Round[]
        +searchReviewsByAuthor(authorId: string): Round[]
        +searchReviewsByReviewer(reviewerId: string): Round[]
        +searchReviewsByStatus(status: string): Round[]
        +searchReviewsByDeadline(deadlineBefore: Date, deadlineAfter: Date): Round[]
        +searchLabMembersByName(nameQuery: string): LabMember[]
        +searchLabMembersByTopic(topicId: string): LabMember[]
        +searchLabMembersByWorkload(workloadThreshold: number): LabMember[]
    }
}

package "Agents" {
    class AIReviewEngineAgent <<Agent>> {
        +analyzeManuscript(paper: Paper): CitationSuggestion[]
        +generateReviewReport(paper: Paper, suggestions: CitationSuggestion[]): AIReviewReport
    }
    class AIGuardrailAgent <<Agent>> {
        +validateCitations(suggestions: CitationSuggestion[]): boolean
        +checkForDuplicates(paper: Paper, suggestions: CitationSuggestion[]): CitationSuggestion[]
    }
    class ChecklistAgent <<Agent>> {
        +verifyFormatting(paper: Paper): boolean
        +autofillMissingItems(paper: Paper, item: ChecklistItem): void
    }
}

package "Services" {
    class LatexService <<Service>> {
        +compileToPDF(overleafLink: string): string
    }
    class LLMService <<Service>> {
        +generateCompletion(prompt: string, modelType?: string): string
        +generateStructuredCompletion(prompt: string, jsonSchema: any, modelType?: string): any
    }
    class EmailService <<Service>> {
        +sendNotification(userId: string, subject: string, body: string): void
        +sendPasswordResetEmail(email: string, resetLink: string): void
        +retryFailedEmails(): void
    }
    class GitHubService <<Service>> {
        +pushCommentsToRepository(repoUrl: string, comments: any[]): boolean
        +pullLatestManuscript(repoUrl: string): any
    }
    class WebScraperService <<Service>> {
        +scrapeAuthorPublications(authorName: string): any[]
        +searchPaperOnline(title: string): any
        +getPCMembersOfConference(conferenceUrl: string): any[]
        +getConferenceChecklist(conferenceUrl: string): any[]
    }
}

package "Entities" {
    abstract class User <<Entity>> {
        +id: string
        +name: string
        +email: string
        +passwordHash: string
        +role: string[]
        +failedLogins: number
        +lockedUntil?: Date
        +notifications: EmailNotification[]
    }
    class Admin <<Entity>> extends User
    class LabMember <<Entity>> extends User {
        +writtenPapers: Paper[]
        +interests: Topic[]
        +assignments: Assignment[]
        +blackoutPeriods: BlackoutPeriod[]
    }
    class Coordinator <<Entity>> extends User {
        +coordinatedPapers: Paper[]
    }
    class Topic <<Entity>> {
        +id: string
        +name: string
    }
    enum EmailStatus {
        Pending
        Sent
        Failed
    }
    class EmailNotification <<Entity>> {
        +id: string
        +subject: string
        +body: string
        +sentAt?: Date
        +status: EmailStatus
        +recipient: User
    }
    class BlackoutPeriod <<Entity>> {
        +id: string
        +startDate: Date
        +endDate: Date
        +reason?: string
        +member: LabMember
    }
    enum PaperStatus {
        Draft
        Registered
        HumanReview
        AIReview
        Completed
        Closed
        Archived
    }
    class Paper <<Entity>> {
        +id: string
        +title: string
        +abstractText: string
        +creationTime: Date
        +targetVenue: string
        +status: PaperStatus
        +manuscriptUrl?: string
        +overleafLink?: string
        +authors: LabMember[]
        +coordinator: Coordinator
        +topics: Topic[]
        +parentPapers: Paper[]
        +rounds: Round[]
    }
    enum RoundStatus {
        Open
        Closed
    }
    class Round <<Entity>> {
        +id: string
        +roundNumber: number
        +deadline: Date
        +status: RoundStatus
        +paper: Paper
        +proposedReviewers: LabMember[]
        +assignments: Assignment[]
        +aiReviewReports: AIReviewReport[]
        +checklistItems: ChecklistItem[]
    }
    class ChecklistItem <<Entity>> {
        +id: string
        +description: string
        +isChecked: boolean
        +round: Round
    }
    enum AssignmentStatus {
        Invited
        Accepted
        Declined
        Overdue
        Completed
        Reassigned
    }
    class Assignment <<Entity>> {
        +id: string
        +status: AssignmentStatus
        +round: Round
        +reviewer: LabMember
        +extension?: Extension
        +reviewSummary: Summary
        +rating: Rating
    }
    class Summary <<Entity>> {
        +id: string
        +text: string
        +assignment: Assignment
    }
    class Rating <<Entity>> {
        +id: string
        +qualityScore: number
        +quantityScore: number
        +timeScore: number
        +assignment: Assignment
        +rater: LabMember
    }
    enum ExtensionStatus {
        Pending
        Approved
        Rejected
    }
    class Extension <<Entity>> {
        +id: string
        +reason: string
        +acceptedDate?: Date
        +status: ExtensionStatus
        +assignment: Assignment
    }
    class CitationSuggestion <<Entity>> {
        +id: string
        +title: string
        +authors: string
        +year: number
        +venue: string
        +doi?: string
        +evidence: string
    }
    class AIReviewReport <<Entity>> {
        +id: string
        +generatedReportUrl: string
        +annotatedPdfUrl: string
        +round: Round
        +citationSuggestions: CitationSuggestion[]
    }
}

' ── Controller → Service dependencies ──
AccountController ..> EmailService : "requests email sending"
AssignmentController ..> EmailService : "sends invitations/reminders"
RoundController ..> EmailService : "queues deadline reminders"
AIReviewController ..> GitHubService : "pushes comments to Overleaf"
AIReviewController ..> LatexService : "renders PDF"
AIReviewController ..> WebScraperService : "scrapes PC related work"

' ── Controller → Agent dependencies ──
AIReviewController ..> AIReviewEngineAgent : "delegates analysis"
AIReviewController ..> AIGuardrailAgent : "validates AI output"
PaperController ..> ChecklistAgent : "verifies compliance"

' ── Agent → Service dependencies ──
AIReviewEngineAgent ..> LLMService : "requests AI analysis"
AIGuardrailAgent ..> LLMService : "requests AI validation"
ChecklistAgent ..> LLMService : "requests missing item autofill"

' ── Entity relationships ──
Paper "*" -- "*" Topic: topics
Paper "*" -- "*" Paper: parentPapers
Paper "1" -- "*" Round: rounds

Round "1" *-- "*" Assignment : contains
Round "1" *-- "*" ChecklistItem : owns
Round "1" -- "*" LabMember: proposedReviewers
Round "1" -- "*" AIReviewReport: aiReviewReports

Assignment "*" --- "1" LabMember: reviewer
Assignment "1" -- "1" Summary: reviewSummary
Assignment "1" -- "1" Rating: rating
Assignment "1" -- "0..1" Extension: extension

LabMember "*" ---- "*" Topic: interests
LabMember "1" --- "*" BlackoutPeriod: blackoutPeriods

Coordinator "1" -- "*" Paper: coordinatedPapers
LabMember "*" -- "*" Paper: writtenPapers

AIReviewReport "1" *-- "*" CitationSuggestion: citationSuggestions

Rating "*" ---- "1" LabMember: rater

User "1" -- "*" EmailNotification: notifications

@enduml
