@startuml BILSEN High-Level Architecture
title BILSEN Review Management System - High-Level Architecture Diagram

skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype ortho
skinparam DefaultTextAlignment center
skinparam ranksep 60
skinparam nodesep 50

actor Author
actor Reviewer
actor Coordinator
actor Admin

rectangle "Client Layer" {
  component "Next.js Web UI \n(React Monolith)" as FE
}

rectangle "Application Layer\n(Express.js Backend / TypeORM)" {

  package "Access & Identity" {
    component "Account Service\n(Login, Signup, Recovery)" as ACCOUNT
  }

  package "Paper & Review Core" {
    component "Paper Management Service\n(Abstracts, Topics, Links)" as PAPER
    component "Round & Assignment Service\n(Creation, Deadlines, Invites)" as ASSIGN
    component "Reviewer Response Service\n(Accept, Decline, Submit)" as REVIEW
  }

  package "Automation, Intelligence & Search" {
    component "AI Review Service\n(Reports, PDFs, Related Work)" as AI
    component "Search Service\n(Global search capabilities)" as SEARCH
  }

  package "Insights & Governance" {
    component "Rating & Analytics Service\n(Reviewer Ratings, Leaderboard)" as ANALYTICS
    component "Admin Service\n(Global Topics, Users)" as ADMIN_SVC
  }
}

database "SQLite Database\n(Local Storage)" as DB

cloud "AI Inference Engine" as AI_ENGINE
cloud "Overleaf" as OVERLEAF
cloud "Scholarly Index" as INDEX

Author --> FE
Reviewer --> FE
Coordinator --> FE
Admin --> FE

FE --> ACCOUNT
FE --> PAPER
FE --> ASSIGN
FE --> REVIEW
FE --> AI
FE --> SEARCH
FE --> ANALYTICS
FE --> ADMIN_SVC

ACCOUNT --> DB
PAPER --> DB
ASSIGN --> DB
REVIEW --> DB
AI --> DB
SEARCH --> DB
ANALYTICS --> DB
ADMIN_SVC --> DB


PAPER --> OVERLEAF : Maintains Links
AI --> AI_ENGINE : Generate Reports
AI --> INDEX : Fetch Related Work

ASSIGN --> PAPER : Read Parent Papers / Topics
REVIEW --> ASSIGN : Validate Assignment state
ANALYTICS --> REVIEW : Fetch completions
SEARCH --> PAPER : Indexing

@enduml
