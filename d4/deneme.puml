@startuml
title BILSEN Review Management System - Enhanced Subsystem Decomposition

' Formatting improvements
skinparam componentStyle rectangle
skinparam packageStyle folder
skinparam shadowing false
skinparam nodesep 60
skinparam ranksep 80
skinparam padding 10


' PRESENTATION LAYER
' =========================
package "Presentation Layer" #E1F5FE {
  folder "Lab Member UI" as UI_Lab
  folder "Coordinator UI" as UI_Coord
  folder "Admin UI" as UI_Admin
}

' =========================
' APPLICATION LAYER
' =========================
package "Application Layer" #F3E5F5 {
  folder "Account Manager" as APP_Account
  folder "Paper Manager" as APP_Paper
  folder "Round & Assignment Manager" as APP_Round
  folder "Review Response Manager" as APP_Response
  folder "Rating & Analytics Manager" as APP_Analytics
  folder "System Admin Manager" as APP_Admin
  folder "AI Review Manager" as APP_AI
  folder "Notification Manager" as SUP_Notify
  folder "Reviewer Suggestion Manager" as SUP_Suggest
  folder "Deadline Manager" as SUP_Deadline
}

' =========================
' ABSTRACTION LAYER
' =========================
package "Abstraction Layer" #FFF3E0 {
  folder "Auth Service" as ABS_Auth
  folder "Database Manager" as ABS_DB
  folder "File Manager" as ABS_File
  folder "Notification Service" as ABS_Notif
  folder "AI Service" as ABS_AI
  folder "Search Adapter" as ABS_Search
}

' =========================
' DATA / EXTERNAL LAYER
' =========================
package "Data / External Layer" #E8F5E9 {
  database "SQLite DB" as DB
  cloud "File Storage" as FILES
  cloud "Email Service" as EMAIL
  cloud "AI Engine" as AI_EXT
  cloud "Scholarly Index" as INDEX
}

' =========================
' UI → DIRECT
' =========================
UI_Lab --> APP_Account
UI_Lab --> APP_Paper
UI_Lab --> APP_Response
UI_Lab --> APP_Analytics
UI_Lab --> APP_AI

UI_Coord --> APP_Round
UI_Coord --> APP_Response
UI_Coord --> APP_Analytics

UI_Admin --> APP_Admin
UI_Admin --> APP_Account

' =========================
' DIRECT → SUPPORT
' =========================
APP_Round --> SUP_Suggest
APP_Round --> SUP_Deadline
APP_Round --> SUP_Notify

APP_Response --> SUP_Notify
APP_Response --> SUP_Deadline

' =========================
' APPLICATION → ABSTRACTION
' =========================
APP_Account --> ABS_Auth
APP_Account --> ABS_DB

APP_Paper --> ABS_DB
APP_Paper --> ABS_File

APP_Round --> ABS_DB
APP_Round --> ABS_Notif

APP_Response --> ABS_DB
APP_Response --> ABS_File

APP_Analytics --> ABS_DB
APP_Admin --> ABS_DB
APP_AI --> ABS_AI

SUP_Notify --> ABS_Notif
SUP_Deadline --> ABS_DB
SUP_Suggest --> ABS_DB

' =========================
' ABSTRACTION → DATA
' =========================
ABS_DB --> DB
ABS_File --> FILES
ABS_Notif --> EMAIL
ABS_AI --> AI_EXT
ABS_Search --> INDEX

@enduml