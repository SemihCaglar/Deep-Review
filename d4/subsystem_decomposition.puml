@startuml BILSEN Subsystem Decomposition
title BILSEN Review Management System\nSubsystem Decomposition Diagram

skinparam componentStyle uml2
skinparam shadowing false
skinparam linetype ortho
skinparam DefaultTextAlignment center
skinparam ranksep 60
skinparam nodesep 50

package "Client Subsystem" {
  component "Web User Interface" as WebUI
}

package "Application Layer Subsystems" {
  component "API Routing Subsystem" as APIRouter
  component "Identity & Access Subsystem" as AuthSvc
  component "Paper Management Subsystem" as PaperSvc
  component "Review Workflow Subsystem" as ReviewSvc
  component "Analytics & Rating Subsystem" as AdminSvc
  component "AI Integration Subsystem" as AISvc
}

package "Data Storage Subsystem" {
  component "Database Access (ORM) Subsystem" as DB_ORM
  database "SQLite Database" as SQLite
}

package "External Systems" {
  component "Overleaf" as Overleaf
  component "AI Inference Engine" as AIEngine
  component "Scholarly API" as Scholar
}

' Dependencies
WebUI -.> APIRouter : HTTP/REST
APIRouter -.> AuthSvc : Routes
APIRouter -.> PaperSvc : Routes
APIRouter -.> ReviewSvc : Routes
APIRouter -.> AdminSvc : Routes
APIRouter -.> AISvc : Routes

AuthSvc -.> DB_ORM
PaperSvc -.> DB_ORM
ReviewSvc -.> DB_ORM
AdminSvc -.> DB_ORM
AISvc -.> DB_ORM

DB_ORM -.> SQLite

PaperSvc -.> Overleaf : External Integration
AISvc -.> AIEngine : Generates Reports
AISvc -.> Scholar : Fetches Context

@enduml
